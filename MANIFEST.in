# Include README and LICENSE
include README.md
include LICENSE

# Include data directory (templates, ontology, examples)
recursive-include data *

# Include scripts for automation
recursive-include scripts *.sh *.py

# Include package data
recursive-include caas_framework/templates *
recursive-include caas_framework/config *.yaml *.yml *.json
recursive-include caas_framework *.yaml *.yml *.json

# Exclude unnecessary files
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
global-exclude tests
global-exclude .git*
global-exclude .mypy_cache
global-exclude .pytest_cache
