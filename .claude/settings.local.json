{
  "permissions": {
    "allow": [
      "Bash(python3:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(python:*)"
    ]
  },
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-cleanup.sh"
          }
        ]
      }
    ]
  }
}
