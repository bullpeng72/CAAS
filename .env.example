# =============================================================================
# CAAS - CrewAI Agent Auto-generation System
# Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# LLM API Keys (Required)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# LLM Provider: openai, anthropic, ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# OpenAI Model for CrewAI (supports structured outputs)
# Structured outputs are only supported by: gpt-4o, gpt-4o-mini (2024-08-06+)
OPENAI_MODEL_NAME=gpt-4o

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# FastAPI Backend URL (for Streamlit UI)
CAAS_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Knowledge Graph Backend (Choose one)
# -----------------------------------------------------------------------------
# Option 1: Embedded Graph (Recommended for quick start - No Neo4j required!)
GRAPH_BACKEND=embedded
EMBEDDED_GRAPH_STORAGE=./data/embedded_graph.json

# Option 2: Neo4j (For production or large-scale usage)
# GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=CAAS
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# -----------------------------------------------------------------------------
# Code Generation Settings
# -----------------------------------------------------------------------------
OUTPUT_DIR=./generated
TEMPLATE_DIR=./data/templates

# -----------------------------------------------------------------------------
# Vector Database Configuration (Optional)
# -----------------------------------------------------------------------------
# Common Vector DB settings
# VECTORDB_INDEX_NAME=caas-vectors

# Pinecone
# PINECONE_API_KEY=your-pinecone-api-key-here
# PINECONE_INDEX_NAME=caas-vectors
# PINECONE_ENVIRONMENT=us-west1-gcp

# Qdrant (local or cloud)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-qdrant-api-key-here

# -----------------------------------------------------------------------------
# PostgreSQL Database (Optional - for production)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_database
# POSTGRES_USER=your_db_user
# POSTGRES_PASSWORD=your_db_password
# POSTGRES_DB=your_database

# -----------------------------------------------------------------------------
# Optional: Ollama Configuration (for local LLM)
# -----------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:70b

# -----------------------------------------------------------------------------
# Optional: MCP (Model Context Protocol) Configuration
# -----------------------------------------------------------------------------
# MCP 활성화 여부
# MCP_ENABLED=false

# MCP 전송 타입: stdio (로컬 프로세스), sse (Server-Sent Events), http (Streamable HTTP)
# MCP_TRANSPORT_TYPE=http

# HTTP/SSE 전송 설정
# MCP_SERVER_URL=http://localhost:3000

# Stdio 전송 설정 (로컬 MCP 서버 실행)
# MCP_SERVER_COMMAND=python3
# MCP_SERVER_ARGS=servers/my_mcp_server.py

# 연결 타임아웃 (초)
# MCP_CONNECT_TIMEOUT=30

# 사용할 MCP 도구 목록 (쉼표로 구분, 비워두면 전체 도구 사용)
# MCP_TOOLS=filesystem,database,api_client

# 예제 설정:
# 1. HTTP 전송 (원격 MCP 서버)
#    MCP_ENABLED=true
#    MCP_TRANSPORT_TYPE=http
#    MCP_SERVER_URL=http://localhost:3000
#
# 2. Stdio 전송 (로컬 MCP 서버)
#    MCP_ENABLED=true
#    MCP_TRANSPORT_TYPE=stdio
#    MCP_SERVER_COMMAND=python3
#    MCP_SERVER_ARGS=path/to/server.py
#
# 3. SSE 전송 (Server-Sent Events)
#    MCP_ENABLED=true
#    MCP_TRANSPORT_TYPE=sse
#    MCP_SERVER_URL=http://localhost:8000/sse

# -----------------------------------------------------------------------------
# CrewAI Tool API Keys (Optional - Required for specific tools)
# -----------------------------------------------------------------------------
#
# CAAS에서 지원하는 CrewAI 도구별 API 키 설정
# - ✅ REQUIRED: 기본 기능에 필요
# - 🔧 CORE: 자주 사용되는 도구
# - 📦 OPTIONAL: 특정 기능 사용 시 필요
#
# API 키 발급 방법:
# - OpenAI: https://platform.openai.com/api-keys
# - Serper (Google Search): https://serper.dev/api-key
# - Brave Search: https://brave.com/search/api/
# - Tavily (AI Search): https://tavily.com/
# - Firecrawl: https://firecrawl.dev/
# - GitHub: https://github.com/settings/tokens
# - YouTube: https://console.cloud.google.com/apis/credentials
#

# ============================================================================
# ✅ REQUIRED API Keys (기본 기능에 필수)
# ============================================================================

# OpenAI API (VisionTool, DallETool, 기본 LLM)
# - 위 "LLM API Keys" 섹션에서 OPENAI_API_KEY 설정됨
# - VisionTool: 이미지 분석
# - DallETool: 이미지 생성 (현재 CrewAI에서 사용 불가)

# ============================================================================
# 🔧 CORE Tools (자주 사용되는 도구)
# ============================================================================

# 🔍 Web Search Tools
# SerperDevTool: Google 검색 (Serper API) - 가장 포괄적인 검색 결과
SERPER_API_KEY=your-serper-api-key-here

# BraveSearchTool: 프라이버시 중심 Brave 검색
# BRAVE_API_KEY=your-brave-api-key-here

# TavilySearchTool: AI 최적화 검색 (Agent 작업에 특화)
# TAVILY_API_KEY=your-tavily-api-key-here

# ============================================================================
# 📦 OPTIONAL Tools (특정 기능 사용 시 필요)
# ============================================================================

# 🌐 Web Scraping Tools
# FirecrawlScrapeWebsiteTool: 고급 웹 스크래핑 (JavaScript 렌더링 지원)
# FIRECRAWL_API_KEY=your-firecrawl-api-key-here

# 💻 Code & Integration Tools
# GithubSearchTool: GitHub 검색 및 코드 분석
# GITHUB_API_KEY=your-github-api-key-here

# 🎥 Media Tools
# YoutubeChannelSearchTool, YoutubeVideoSearchTool: YouTube 데이터 API
# YOUTUBE_API_KEY=your-youtube-api-key-here

# 💬 Communication Tools
# SlackSearchTool: Slack 워크스페이스 검색 (⚠️ 현재 CrewAI에서 사용 불가)
# SLACK_API_KEY=your-slack-api-key-here

# ============================================================================
# 참고: 추가 도구 지원 (향후 지원 예정)
# ============================================================================
# 아래 도구들은 CrewAI에서 제공하지만 CAAS에서 아직 완전히 통합되지 않았습니다.
# 필요시 직접 추가 가능합니다.
#
# # EXA Search
# # EXA_API_KEY=your-exa-api-key-here
#
# # Jina AI (웹 스크래핑)
# # JINA_API_KEY=your-jina-api-key-here
#
# # Spider (웹 크롤링)
# # SPIDER_API_KEY=your-spider-key-here
#
# # Stability AI (이미지 생성)
# # STABILITY_API_KEY=your-stability-key-here
#
# # Hugging Face Models
# # HUGGINGFACE_API_KEY=hf_your-hf-key-here

# -----------------------------------------------------------------------------
# MCP Server API Keys (Optional - Required for specific MCP servers)
# -----------------------------------------------------------------------------
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your-token-here     # For GitHub MCP server
# GOOGLE_DRIVE_CREDENTIALS=/path/to/gdrive-creds.json # For Google Drive MCP server

# -----------------------------------------------------------------------------
# Artifact Generation (산출물 자동 생성)
# -----------------------------------------------------------------------------
# Enable automatic generation of development artifacts (기획서, 요구사항분석서, etc.)
ARTIFACT_GENERATION_ENABLED=true

# Output format: markdown, html, pdf, json
ARTIFACT_OUTPUT_FORMAT=markdown

# Output directory for generated artifacts
ARTIFACT_OUTPUT_DIR=./artifacts

# -----------------------------------------------------------------------------
# Individual Artifact Type Control (v0.5.0+)
# -----------------------------------------------------------------------------
# Enable/disable specific artifact types (all default to true)

# 프로젝트 기획서 - Project proposal
ARTIFACT_GENERATION_PROJECT_PROPOSAL=true

# 요구사항 명세서 - Requirements specification
ARTIFACT_GENERATION_REQUIREMENTS_SPEC=true

# 아키텍처 설계서 - Architecture design document
ARTIFACT_GENERATION_ARCHITECTURE_DESIGN=true

# 데이터 설계서 - Data model and schema design
ARTIFACT_GENERATION_DATA_DESIGN=true

# API 설계서 - REST API endpoints and interfaces
ARTIFACT_GENERATION_API_DESIGN=true

# 에이전트 설계서 - AI agent roles and tasks
ARTIFACT_GENERATION_AGENT_DESIGN=true

# 테스트 계획서 - Test strategy and scenarios
ARTIFACT_GENERATION_TEST_PLAN=true

# 테스트 결과 리포트 - Test execution results
ARTIFACT_GENERATION_TEST_REPORT=true

# 코드 리뷰 리포트 - Code quality, security, performance analysis
ARTIFACT_GENERATION_CODE_REVIEW=true

# 배포 가이드 - Deployment procedures and configuration
ARTIFACT_GENERATION_DEPLOYMENT_GUIDE=true

# =============================================================================
# Quality Gate Settings (v0.4.1+)
# =============================================================================
# Quality Gates enforce quality standards at each development phase.
# Configure thresholds and behavior here.

# -----------------------------------------------------------------------------
# Global Quality Gate Configuration
# -----------------------------------------------------------------------------
# Enable strict mode: halt workflow on Quality Gate failure (true/false)
CAAS_STRICT_QUALITY_GATES=true

# Quality Gate profile: strict, balanced, permissive, custom
# - strict: High thresholds (8.5-9.0), 100% pass rate - for production
# - balanced: Moderate thresholds (7.0-8.0), 80-85% pass rate - default
# - permissive: Low thresholds (5.0-6.0), 60% pass rate - for prototyping
# - custom: Use individual metric settings below
CAAS_QG_PROFILE=balanced

# -----------------------------------------------------------------------------
# Phase 1: DISCOVERY Quality Gate Thresholds
# -----------------------------------------------------------------------------
# Uncomment and customize to override profile defaults
# CAAS_QG_DISCOVERY_REQUIREMENT_CLARITY=7.0
# CAAS_QG_DISCOVERY_FEATURE_COMPLETENESS=7.0
# CAAS_QG_DISCOVERY_GOLDEN_DATA_ALIGNMENT=80.0
# CAAS_QG_DISCOVERY_MIN_PASS_RATE=85.0

# -----------------------------------------------------------------------------
# Phase 2: ARCHITECTURE Quality Gate Thresholds
# -----------------------------------------------------------------------------
# CAAS_QG_ARCHITECTURE_COMPONENT_CLARITY=7.0
# CAAS_QG_ARCHITECTURE_ARCHITECTURAL_COHERENCE=7.0
# CAAS_QG_ARCHITECTURE_SCALABILITY_SCORE=6.0
# CAAS_QG_ARCHITECTURE_MIN_PASS_RATE=80.0

# -----------------------------------------------------------------------------
# Phase 3: DESIGN Quality Gate Thresholds
# -----------------------------------------------------------------------------
# CAAS_QG_DESIGN_AGENT_ROLE_CLARITY=7.0
# CAAS_QG_DESIGN_TASK_COMPLETENESS=7.0
# CAAS_QG_DESIGN_DEPENDENCY_CORRECTNESS=8.0
# CAAS_QG_DESIGN_TOOL_APPROPRIATENESS=7.0
# CAAS_QG_DESIGN_MIN_PASS_RATE=85.0

# -----------------------------------------------------------------------------
# Phase 4: DELIVERY Quality Gate Thresholds
# -----------------------------------------------------------------------------
# CAAS_QG_DELIVERY_CODE_QUALITY=7.0
# CAAS_QG_DELIVERY_IMPLEMENTATION_COMPLETENESS=8.0
# CAAS_QG_DELIVERY_SECURITY_SCORE=8.0
# CAAS_QG_DELIVERY_TEST_COVERAGE=70.0
# CAAS_QG_DELIVERY_MIN_PASS_RATE=80.0

# -----------------------------------------------------------------------------
# Phase 5: QUALITY_ASSURANCE Quality Gate Thresholds
# -----------------------------------------------------------------------------
# CAAS_QG_QA_TEST_COMPLETENESS=7.0
# CAAS_QG_QA_TEST_CORRECTNESS=8.0
# CAAS_QG_QA_COVERAGE_PERCENTAGE=75.0
# CAAS_QG_QA_MIN_PASS_RATE=85.0

# -----------------------------------------------------------------------------
# Quality Gate Usage Examples
# -----------------------------------------------------------------------------
# Example 1: Strict production settings
#   CAAS_QG_PROFILE=strict
#   CAAS_STRICT_QUALITY_GATES=true
#
# Example 2: Permissive for rapid prototyping
#   CAAS_QG_PROFILE=permissive
#   CAAS_STRICT_QUALITY_GATES=false
#
# Example 3: Custom security-focused settings
#   CAAS_QG_PROFILE=custom
#   CAAS_QG_DELIVERY_SECURITY_SCORE=9.5
#   CAAS_QG_DELIVERY_CODE_QUALITY=9.0
#   CAAS_STRICT_QUALITY_GATES=true
#
# Example 4: Override via CLI (bypasses .env)
#   caas generate "requirement" --no-strict-quality-gates
#   caas generate "requirement" --quality-profile permissive
