# =============================================================================
# CAAS - CrewAI Agent Auto-generation System
# Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# LLM API Keys (Required)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Default LLM Provider: openai, anthropic, ollama
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o

# OpenAI Model for CrewAI (supports structured outputs)
# Structured outputs are only supported by: gpt-4o, gpt-4o-mini (2024-08-06+)
OPENAI_MODEL_NAME=gpt-4o

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# FastAPI Backend URL (for Streamlit UI)
CAAS_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Knowledge Graph Backend (Choose one)
# -----------------------------------------------------------------------------
# Option 1: Embedded Graph (Recommended for quick start - No Neo4j required!)
GRAPH_BACKEND=embedded
EMBEDDED_GRAPH_STORAGE=./data/embedded_graph.json

# Option 2: Neo4j (For production or large-scale usage)
# GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=CAAS
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# -----------------------------------------------------------------------------
# Code Generation Settings
# -----------------------------------------------------------------------------
OUTPUT_DIR=./generated
TEMPLATE_DIR=./data/templates

# -----------------------------------------------------------------------------
# Vector Database Configuration (Optional)
# -----------------------------------------------------------------------------
# Common Vector DB settings
# VECTORDB_INDEX_NAME=caas-vectors

# Pinecone
# PINECONE_API_KEY=your-pinecone-api-key-here
# PINECONE_INDEX_NAME=caas-vectors
# PINECONE_ENVIRONMENT=us-west1-gcp

# Qdrant (local or cloud)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-qdrant-api-key-here

# -----------------------------------------------------------------------------
# PostgreSQL Database (Optional - for production)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_database
# POSTGRES_USER=your_db_user
# POSTGRES_PASSWORD=your_db_password
# POSTGRES_DB=your_database

# -----------------------------------------------------------------------------
# Optional: Ollama Configuration (for local LLM)
# -----------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:70b

# -----------------------------------------------------------------------------
# Optional: MCP (Model Context Protocol) Configuration
# -----------------------------------------------------------------------------
# MCP 활성화 여부
# MCP_ENABLED=false

# MCP 전송 타입: stdio (로컬 프로세스), sse (Server-Sent Events), http (Streamable HTTP)
# MCP_TRANSPORT_TYPE=http

# HTTP/SSE 전송 설정
# MCP_SERVER_URL=http://localhost:3000

# Stdio 전송 설정 (로컬 MCP 서버 실행)
# MCP_SERVER_COMMAND=python3
# MCP_SERVER_ARGS=servers/my_mcp_server.py

# 연결 타임아웃 (초)
# MCP_CONNECT_TIMEOUT=30

# 사용할 MCP 도구 목록 (쉼표로 구분, 비워두면 전체 도구 사용)
# MCP_TOOLS=filesystem,database,api_client

# 예제 설정:
# 1. HTTP 전송 (원격 MCP 서버)
#    MCP_ENABLED=true
#    MCP_TRANSPORT_TYPE=http
#    MCP_SERVER_URL=http://localhost:3000
#
# 2. Stdio 전송 (로컬 MCP 서버)
#    MCP_ENABLED=true
#    MCP_TRANSPORT_TYPE=stdio
#    MCP_SERVER_COMMAND=python3
#    MCP_SERVER_ARGS=path/to/server.py
#
# 3. SSE 전송 (Server-Sent Events)
#    MCP_ENABLED=true
#    MCP_TRANSPORT_TYPE=sse
#    MCP_SERVER_URL=http://localhost:8000/sse

# -----------------------------------------------------------------------------
# CrewAI Tool API Keys (Optional - Required for specific tools)
# -----------------------------------------------------------------------------

# Search Tools
# SERPER_API_KEY=your-serper-api-key-here         # For SerperDevTool (Google Search)
# BRAVE_API_KEY=your-brave-api-key-here           # For BraveSearchTool
# TAVILY_API_KEY=your-tavily-api-key-here         # For TavilySearchTool
# EXA_API_KEY=your-exa-api-key-here               # For EXASearchTool

# GitHub
# GITHUB_TOKEN=ghp_your-github-token-here         # For GithubSearchTool (optional)

# Web Scraping
# FIRECRAWL_API_KEY=your-firecrawl-key-here       # For FirecrawlScrapeWebsiteTool
# JINA_API_KEY=your-jina-key-here                 # For JinaScrapeWebsiteTool
# SPIDER_API_KEY=your-spider-key-here             # For SpiderTool

# Communication
# TWILIO_ACCOUNT_SID=your-twilio-sid-here         # For TwilioTool
# TWILIO_AUTH_TOKEN=your-twilio-token-here        # For TwilioTool
# TWILIO_PHONE_NUMBER=+1234567890                 # For TwilioTool
# SLACK_BOT_TOKEN=xoxb-your-slack-token-here      # For SlackSearchTool

# Analytics
# GOOGLE_ANALYTICS_CREDENTIALS=/path/to/ga-creds.json  # For GoogleAnalyticsSearchTool
# MIXPANEL_API_SECRET=your-mixpanel-secret-here        # For MixpanelSearchTool

# Productivity (Google Workspace)
# GOOGLE_CALENDAR_CREDENTIALS=/path/to/calendar-creds.json  # For GoogleCalendarSearchTool
# GOOGLE_DOCS_CREDENTIALS=/path/to/docs-creds.json          # For GoogleDocsSearchTool
# GOOGLE_SHEETS_CREDENTIALS=/path/to/sheets-creds.json      # For GoogleSheetsSearchTool

# Notion
# NOTION_API_KEY=secret_your-notion-key-here      # For NotionSearchTool

# AI/ML Tools
# OPENAI_API_KEY=sk-your-openai-key-here          # For DallETool, OpenAITool (set above)
# STABILITY_API_KEY=your-stability-key-here       # For StableDiffusionTool
# HUGGINGFACE_API_KEY=hf_your-hf-key-here         # For HuggingFaceModelTool (optional)

# Database Tools
# MYSQL_CONNECTION_STRING=mysql://user:pass@host:port/db    # For MySQLSearchTool
# MONGODB_URI=mongodb://user:pass@host:port/db              # For MongoDBVectorSearchTool
# SNOWFLAKE_ACCOUNT=your-account.snowflakecomputing.com     # For SnowflakeSearchTool
# SNOWFLAKE_USER=your-snowflake-username                    # For SnowflakeSearchTool
# SNOWFLAKE_PASSWORD=your-snowflake-password                # For SnowflakeSearchTool
# SNOWFLAKE_WAREHOUSE=your-warehouse-name                   # For SnowflakeSearchTool (optional)

# Other Tools
# MULTION_API_KEY=your-multion-key-here           # For MultiOnTool
# COMPOSIO_API_KEY=your-composio-key-here         # For ComposioTool

# -----------------------------------------------------------------------------
# MCP Server API Keys (Optional - Required for specific MCP servers)
# -----------------------------------------------------------------------------
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your-token-here     # For GitHub MCP server
# GOOGLE_DRIVE_CREDENTIALS=/path/to/gdrive-creds.json # For Google Drive MCP server

# -----------------------------------------------------------------------------
# Artifact Generation (산출물 자동 생성)
# -----------------------------------------------------------------------------
# Enable automatic generation of development artifacts (기획서, 요구사항분석서, etc.)
ARTIFACT_GENERATION_ENABLED=true

# Output format: markdown, html, pdf, json
ARTIFACT_OUTPUT_FORMAT=markdown

# Output directory for generated artifacts
ARTIFACT_OUTPUT_DIR=./artifacts

