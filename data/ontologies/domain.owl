<?xml version="1.0"?>
<rdf:RDF xmlns="http://caas.ai/ontology/domain#"
     xml:base="http://caas.ai/ontology/domain"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:caas="http://caas.ai/ontology/">

    <owl:Ontology rdf:about="http://caas.ai/ontology/domain">
        <rdfs:label>CAAS Domain Ontology</rdfs:label>
        <rdfs:comment>Ontology for domain classifications</rdfs:comment>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>

    <!-- Classes -->
    <owl:Class rdf:about="#Domain">
        <rdfs:label>Domain</rdfs:label>
        <rdfs:comment>A domain or industry classification</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Subdomain">
        <rdfs:label>Subdomain</rdfs:label>
        <rdfs:comment>A subdivision of a domain</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#UseCase">
        <rdfs:label>Use Case</rdfs:label>
        <rdfs:comment>A specific use case within a domain</rdfs:comment>
    </owl:Class>

    <!-- Domain Instances -->
    <owl:Class rdf:about="#Finance">
        <rdfs:subClassOf rdf:resource="#Domain"/>
        <rdfs:label>Finance</rdfs:label>
        <rdfs:comment>Financial services and analysis</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Technology">
        <rdfs:subClassOf rdf:resource="#Domain"/>
        <rdfs:label>Technology</rdfs:label>
        <rdfs:comment>Information technology and software</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Healthcare">
        <rdfs:subClassOf rdf:resource="#Domain"/>
        <rdfs:label>Healthcare</rdfs:label>
        <rdfs:comment>Healthcare and medical services</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Education">
        <rdfs:subClassOf rdf:resource="#Domain"/>
        <rdfs:label>Education</rdfs:label>
        <rdfs:comment>Education and learning</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Marketing">
        <rdfs:subClassOf rdf:resource="#Domain"/>
        <rdfs:label>Marketing</rdfs:label>
        <rdfs:comment>Marketing and advertising</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Legal">
        <rdfs:subClassOf rdf:resource="#Domain"/>
        <rdfs:label>Legal</rdfs:label>
        <rdfs:comment>Legal services and compliance</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Research">
        <rdfs:subClassOf rdf:resource="#Domain"/>
        <rdfs:label>Research</rdfs:label>
        <rdfs:comment>Research and development</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#General">
        <rdfs:subClassOf rdf:resource="#Domain"/>
        <rdfs:label>General</rdfs:label>
        <rdfs:comment>General purpose applications</rdfs:comment>
    </owl:Class>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="#hasSubdomain">
        <rdfs:domain rdf:resource="#Domain"/>
        <rdfs:range rdf:resource="#Subdomain"/>
        <rdfs:label>has subdomain</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#parentDomain">
        <rdfs:domain rdf:resource="#Subdomain"/>
        <rdfs:range rdf:resource="#Domain"/>
        <rdfs:label>parent domain</rdfs:label>
        <owl:inverseOf rdf:resource="#hasSubdomain"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasUseCase">
        <rdfs:domain rdf:resource="#Domain"/>
        <rdfs:range rdf:resource="#UseCase"/>
        <rdfs:label>has use case</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#relatedDomain">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="#Domain"/>
        <rdfs:range rdf:resource="#Domain"/>
        <rdfs:label>related domain</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#recommendsRole">
        <rdfs:domain rdf:resource="#Domain"/>
        <rdfs:range rdf:resource="http://caas.ai/ontology/agent#Role"/>
        <rdfs:label>recommends role</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#recommendsTool">
        <rdfs:domain rdf:resource="#Domain"/>
        <rdfs:range rdf:resource="http://caas.ai/ontology/task#Tool"/>
        <rdfs:label>recommends tool</rdfs:label>
    </owl:ObjectProperty>

    <!-- Data Properties -->
    <owl:DatatypeProperty rdf:about="#domainName">
        <rdfs:domain rdf:resource="#Domain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>domain name</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#domainDescription">
        <rdfs:domain rdf:resource="#Domain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>domain description</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#keywords">
        <rdfs:domain rdf:resource="#Domain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>keywords</rdfs:label>
        <rdfs:comment>Comma-separated keywords for the domain</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#useCaseName">
        <rdfs:domain rdf:resource="#UseCase"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>use case name</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#useCaseDescription">
        <rdfs:domain rdf:resource="#UseCase"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>use case description</rdfs:label>
    </owl:DatatypeProperty>

</rdf:RDF>
