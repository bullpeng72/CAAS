<?xml version="1.0"?>
<rdf:RDF xmlns="http://caas.ai/ontology/task#"
     xml:base="http://caas.ai/ontology/task"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:caas="http://caas.ai/ontology/">

    <owl:Ontology rdf:about="http://caas.ai/ontology/task">
        <rdfs:label>CAAS Task Ontology</rdfs:label>
        <rdfs:comment>Ontology for CrewAI Task definitions</rdfs:comment>
        <owl:versionInfo>1.0</owl:versionInfo>
        <owl:imports rdf:resource="http://caas.ai/ontology/agent"/>
    </owl:Ontology>

    <!-- Classes -->
    <owl:Class rdf:about="#Task">
        <rdfs:label>Task</rdfs:label>
        <rdfs:comment>A task to be performed by an agent</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#TaskType">
        <rdfs:label>Task Type</rdfs:label>
        <rdfs:comment>Classification of task types</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Tool">
        <rdfs:label>Tool</rdfs:label>
        <rdfs:comment>A tool that can be used by agents</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Output">
        <rdfs:label>Output</rdfs:label>
        <rdfs:comment>Expected output from a task</rdfs:comment>
    </owl:Class>

    <!-- Task Type Subclasses -->
    <owl:Class rdf:about="#ResearchTask">
        <rdfs:subClassOf rdf:resource="#TaskType"/>
        <rdfs:label>Research Task</rdfs:label>
        <rdfs:comment>Task focused on research and information gathering</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#AnalysisTask">
        <rdfs:subClassOf rdf:resource="#TaskType"/>
        <rdfs:label>Analysis Task</rdfs:label>
        <rdfs:comment>Task focused on data analysis</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#WritingTask">
        <rdfs:subClassOf rdf:resource="#TaskType"/>
        <rdfs:label>Writing Task</rdfs:label>
        <rdfs:comment>Task focused on content creation</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#CodingTask">
        <rdfs:subClassOf rdf:resource="#TaskType"/>
        <rdfs:label>Coding Task</rdfs:label>
        <rdfs:comment>Task focused on software development</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ReviewTask">
        <rdfs:subClassOf rdf:resource="#TaskType"/>
        <rdfs:label>Review Task</rdfs:label>
        <rdfs:comment>Task focused on quality review</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#PlanningTask">
        <rdfs:subClassOf rdf:resource="#TaskType"/>
        <rdfs:label>Planning Task</rdfs:label>
        <rdfs:comment>Task focused on planning</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#SummarizationTask">
        <rdfs:subClassOf rdf:resource="#TaskType"/>
        <rdfs:label>Summarization Task</rdfs:label>
        <rdfs:comment>Task focused on summarizing content</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#TranslationTask">
        <rdfs:subClassOf rdf:resource="#TaskType"/>
        <rdfs:label>Translation Task</rdfs:label>
        <rdfs:comment>Task focused on translation</rdfs:comment>
    </owl:Class>

    <!-- Tool Subclasses -->
    <owl:Class rdf:about="#SearchTool">
        <rdfs:subClassOf rdf:resource="#Tool"/>
        <rdfs:label>Search Tool</rdfs:label>
        <rdfs:comment>Tool for searching information</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#FileTool">
        <rdfs:subClassOf rdf:resource="#Tool"/>
        <rdfs:label>File Tool</rdfs:label>
        <rdfs:comment>Tool for file operations</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#CodeTool">
        <rdfs:subClassOf rdf:resource="#Tool"/>
        <rdfs:label>Code Tool</rdfs:label>
        <rdfs:comment>Tool for code execution</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#APITool">
        <rdfs:subClassOf rdf:resource="#Tool"/>
        <rdfs:label>API Tool</rdfs:label>
        <rdfs:comment>Tool for API interactions</rdfs:comment>
    </owl:Class>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="#hasType">
        <rdfs:domain rdf:resource="#Task"/>
        <rdfs:range rdf:resource="#TaskType"/>
        <rdfs:label>has type</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#requiresTool">
        <rdfs:domain rdf:resource="#Task"/>
        <rdfs:range rdf:resource="#Tool"/>
        <rdfs:label>requires tool</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasOutput">
        <rdfs:domain rdf:resource="#Task"/>
        <rdfs:range rdf:resource="#Output"/>
        <rdfs:label>has output</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#dependsOn">
        <rdfs:domain rdf:resource="#Task"/>
        <rdfs:range rdf:resource="#Task"/>
        <rdfs:label>depends on</rdfs:label>
        <rdfs:comment>Task dependency relationship</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#assignedTo">
        <rdfs:domain rdf:resource="#Task"/>
        <rdfs:range rdf:resource="http://caas.ai/ontology/agent#Agent"/>
        <rdfs:label>assigned to</rdfs:label>
    </owl:ObjectProperty>

    <!-- Data Properties -->
    <owl:DatatypeProperty rdf:about="#taskId">
        <rdfs:domain rdf:resource="#Task"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>task ID</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#description">
        <rdfs:domain rdf:resource="#Task"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>description</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#expectedOutput">
        <rdfs:domain rdf:resource="#Task"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>expected output</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#async">
        <rdfs:domain rdf:resource="#Task"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>async execution</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#toolName">
        <rdfs:domain rdf:resource="#Tool"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>tool name</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#toolDescription">
        <rdfs:domain rdf:resource="#Tool"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>tool description</rdfs:label>
    </owl:DatatypeProperty>

</rdf:RDF>
