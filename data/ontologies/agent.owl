<?xml version="1.0"?>
<rdf:RDF xmlns="http://caas.ai/ontology/agent#"
     xml:base="http://caas.ai/ontology/agent"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:caas="http://caas.ai/ontology/">

    <owl:Ontology rdf:about="http://caas.ai/ontology/agent">
        <rdfs:label>CAAS Agent Ontology</rdfs:label>
        <rdfs:comment>Ontology for CrewAI Agent definitions</rdfs:comment>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>

    <!-- Classes -->
    <owl:Class rdf:about="#Agent">
        <rdfs:label>Agent</rdfs:label>
        <rdfs:comment>An AI agent that performs tasks</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Role">
        <rdfs:label>Role</rdfs:label>
        <rdfs:comment>A role that an agent can assume</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Skill">
        <rdfs:label>Skill</rdfs:label>
        <rdfs:comment>A capability or skill of an agent</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Memory">
        <rdfs:label>Memory</rdfs:label>
        <rdfs:comment>Agent memory configuration</rdfs:comment>
    </owl:Class>

    <!-- Role Subclasses -->
    <owl:Class rdf:about="#Researcher">
        <rdfs:subClassOf rdf:resource="#Role"/>
        <rdfs:label>Researcher</rdfs:label>
        <rdfs:comment>Agent role focused on research and information gathering</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Analyst">
        <rdfs:subClassOf rdf:resource="#Role"/>
        <rdfs:label>Analyst</rdfs:label>
        <rdfs:comment>Agent role focused on data analysis</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Writer">
        <rdfs:subClassOf rdf:resource="#Role"/>
        <rdfs:label>Writer</rdfs:label>
        <rdfs:comment>Agent role focused on content creation</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Developer">
        <rdfs:subClassOf rdf:resource="#Role"/>
        <rdfs:label>Developer</rdfs:label>
        <rdfs:comment>Agent role focused on software development</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Reviewer">
        <rdfs:subClassOf rdf:resource="#Role"/>
        <rdfs:label>Reviewer</rdfs:label>
        <rdfs:comment>Agent role focused on quality review</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Planner">
        <rdfs:subClassOf rdf:resource="#Role"/>
        <rdfs:label>Planner</rdfs:label>
        <rdfs:comment>Agent role focused on planning and organization</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Coordinator">
        <rdfs:subClassOf rdf:resource="#Role"/>
        <rdfs:label>Coordinator</rdfs:label>
        <rdfs:comment>Agent role focused on coordination and management</rdfs:comment>
    </owl:Class>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="#hasRole">
        <rdfs:domain rdf:resource="#Agent"/>
        <rdfs:range rdf:resource="#Role"/>
        <rdfs:label>has role</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasSkill">
        <rdfs:domain rdf:resource="#Agent"/>
        <rdfs:range rdf:resource="#Skill"/>
        <rdfs:label>has skill</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasMemory">
        <rdfs:domain rdf:resource="#Agent"/>
        <rdfs:range rdf:resource="#Memory"/>
        <rdfs:label>has memory</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#usesTool">
        <rdfs:domain rdf:resource="#Agent"/>
        <rdfs:range rdf:resource="http://caas.ai/ontology/task#Tool"/>
        <rdfs:label>uses tool</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#performsTask">
        <rdfs:domain rdf:resource="#Agent"/>
        <rdfs:range rdf:resource="http://caas.ai/ontology/task#Task"/>
        <rdfs:label>performs task</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#belongsToDomain">
        <rdfs:domain rdf:resource="#Agent"/>
        <rdfs:range rdf:resource="http://caas.ai/ontology/domain#Domain"/>
        <rdfs:label>belongs to domain</rdfs:label>
    </owl:ObjectProperty>

    <!-- Data Properties -->
    <owl:DatatypeProperty rdf:about="#agentId">
        <rdfs:domain rdf:resource="#Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>agent ID</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#goal">
        <rdfs:domain rdf:resource="#Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>goal</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#backstory">
        <rdfs:domain rdf:resource="#Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>backstory</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#verbose">
        <rdfs:domain rdf:resource="#Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>verbose</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#allowDelegation">
        <rdfs:domain rdf:resource="#Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>allow delegation</rdfs:label>
    </owl:DatatypeProperty>

</rdf:RDF>
