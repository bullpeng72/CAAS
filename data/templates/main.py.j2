#!/usr/bin/env python3
"""
{{ project.name }}

{{ project.description }}

Generated by CAAS - CrewAI Agent Auto-generation System
Domain: {{ project.domain }}
Generated at: {{ generated_at }}
"""

import os
import sys
from pathlib import Path
from dotenv import load_dotenv

# Load environment variables
load_dotenv()

# Verify API key
if not os.getenv("OPENAI_API_KEY"):
    print("Error: OPENAI_API_KEY not found in environment variables.")
    print("Please set your OpenAI API key in the .env file.")
    sys.exit(1)

from crewai import Crew, Process
from agents import AGENTS, *
from tasks import TASKS, *


def create_crew() -> Crew:
    """Create and configure the crew."""
    return Crew(
        agents=AGENTS,
        tasks=TASKS,
        process=Process.{{ crew.process | lower }},
        verbose={{ crew.verbose | default(true) }},
        memory={{ crew.memory | default(true) }},
        {% if crew.max_rpm %}
        max_rpm={{ crew.max_rpm }},
        {% endif %}
    )


def get_inputs() -> dict:
    """Get inputs for the crew execution."""
    inputs = {}
    {% if inputs %}
    {% for input in inputs %}
    inputs["{{ input.name }}"] = input("{{ input.prompt }}: ")
    {% endfor %}
    {% endif %}
    return inputs


def main():
    """Main entry point."""
    print("=" * 60)
    print(f"  {{ project.name }}")
    print(f"  {{ project.description }}")
    print("=" * 60)
    print()
    
    # Create crew
    print("Initializing crew...")
    crew = create_crew()
    
    # Get inputs
    inputs = get_inputs()
    
    # Run the crew
    print()
    print("Starting crew execution...")
    print("-" * 40)
    
    try:
        result = crew.kickoff(inputs=inputs)
        
        print("-" * 40)
        print("Execution completed successfully!")
        print()
        print("=" * 60)
        print("RESULT:")
        print("=" * 60)
        print(result)
        
        # Save result to file
        output_dir = Path("output")
        output_dir.mkdir(exist_ok=True)
        
        output_file = output_dir / "result.md"
        with open(output_file, "w", encoding="utf-8") as f:
            f.write(f"# {{ project.name }} - Result\n\n")
            f.write(str(result))
        
        print(f"\nResult saved to: {output_file}")
        
        return result
        
    except Exception as e:
        print(f"\nError during execution: {e}")
        raise


if __name__ == "__main__":
    main()
