import os
import sys
import logging
import traceback
from pathlib import Path
from datetime import datetime
from typing import Dict, Any, Optional
from dotenv import load_dotenv

# Configure logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    handlers=[
        logging.StreamHandler(),
        logging.FileHandler('crew_execution.log')
    ]
)
logger = logging.getLogger(__name__)

# Load environment variables
load_dotenv()


class CrewExecutionError(Exception):
    """Custom exception for crew execution errors."""
    pass


def verify_environment() -> None:
    """
    Verify that all required environment variables are set.

    Raises:
        CrewExecutionError: If required environment variables are missing
    """
    required_env_vars = ["OPENAI_API_KEY"]

    missing_vars = [var for var in required_env_vars if not os.getenv(var)]

    if missing_vars:
        error_msg = (
            f"Missing required environment variables: {', '.join(missing_vars)}\n"
            "Please set them in your .env file."
        )
        logger.error(error_msg)
        raise CrewExecutionError(error_msg)

    logger.info("Environment verification passed")


def import_crew_components():
    """
    Import crew components with error handling.

    Returns:
        tuple: (Crew class, Process enum, agents, tasks)

    Raises:
        CrewExecutionError: If imports fail
    """
    try:
        from crewai import Crew, Process
        from agents import AGENTS
        from tasks import TASKS

        logger.info(f"Loaded {len(AGENTS)} agents and {len(TASKS)} tasks")
        return Crew, Process, AGENTS, TASKS

    except ImportError as e:
        error_msg = (
            f"Failed to import required modules: {e}\n"
            "Please ensure crewai is installed: pip install crewai"
        )
        logger.error(error_msg)
        raise CrewExecutionError(error_msg) from e


def create_crew(Crew, Process, agents, tasks) -> Any:
    """
    Create and configure the crew with error handling.

    Args:
        Crew: Crew class
        Process: Process enum
        agents: List of agents
        tasks: List of tasks

    Returns:
        Configured Crew instance

    Raises:
        CrewExecutionError: If crew creation fails
    """
    try:
        crew = Crew(
            agents=agents,
            tasks=tasks,
            process=Process.{{ crew.process | lower }},
            verbose={{ crew.verbose | default(true) }},
            memory={{ crew.memory | default(true) }},
            {% if crew.max_rpm %}
            max_rpm={{ crew.max_rpm }},
            {% endif %}
        )

        logger.info("Crew created successfully")
        return crew

    except Exception as e:
        error_msg = f"Failed to create crew: {e}"
        logger.error(error_msg)
        raise CrewExecutionError(error_msg) from e


def get_inputs() -> Dict[str, str]:
    """
    Get inputs for the crew execution with validation.

    Returns:
        dict: Input values

    Raises:
        CrewExecutionError: If input collection fails
    """
    inputs = {}

    {% if inputs %}
    try:
        {% for input in inputs %}
        value = input("{{ input.prompt }}: ").strip()

        # Validation
        {% if input.required | default(true) %}
        if not value:
            raise CrewExecutionError("{{ input.name }} is required")
        {% endif %}

        {% if input.min_length %}
        if len(value) < {{ input.min_length }}:
            raise CrewExecutionError(
                "{{ input.name }} must be at least {{ input.min_length }} characters"
            )
        {% endif %}

        inputs["{{ input.name }}"] = value
        logger.info(f"Collected input: {{ input.name }}")
        {% endfor %}

    except KeyboardInterrupt:
        logger.info("Input collection cancelled by user")
        raise CrewExecutionError("Input collection cancelled") from None

    except Exception as e:
        logger.error(f"Error collecting inputs: {e}")
        raise CrewExecutionError(f"Input collection failed: {e}") from e
    {% else %}
    logger.info("No inputs required for this crew")
    {% endif %}

    return inputs


def save_result(result: Any, success: bool = True) -> Path:
    """
    Save execution result to file.

    Args:
        result: Execution result
        success: Whether execution was successful

    Returns:
        Path: Output file path

    Raises:
        CrewExecutionError: If save fails
    """
    try:
        output_dir = Path("output")
        output_dir.mkdir(exist_ok=True)

        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        status = "success" if success else "error"
        output_file = output_dir / f"result_{status}_{timestamp}.md"

        with open(output_file, "w", encoding="utf-8") as f:
            f.write(f"# {{ project.name }} - {'Result' if success else 'Error'}\n\n")
            f.write(f"**Status:** {status}\n")
            f.write(f"**Timestamp:** {timestamp}\n\n")
            f.write("## Output\n\n")
            f.write(str(result))

        logger.info(f"Result saved to: {output_file}")
        return output_file

    except Exception as e:
        logger.error(f"Failed to save result: {e}")
        # Don't raise, just warn
        return None


def execute_crew(crew: Any, inputs: Dict[str, str], max_retries: int = 3) -> Any:
    """
    Execute the crew with retry logic and error handling.

    Args:
        crew: Crew instance
        inputs: Input values
        max_retries: Maximum number of retries

    Returns:
        Execution result

    Raises:
        CrewExecutionError: If all retries fail
    """
    for attempt in range(1, max_retries + 1):
        try:
            logger.info(f"Starting crew execution (attempt {attempt}/{max_retries})...")

            result = crew.kickoff(inputs=inputs)

            logger.info("Execution completed successfully!")
            return result

        except KeyboardInterrupt:
            logger.info("Execution cancelled by user")
            raise CrewExecutionError("Execution cancelled") from None

        except Exception as e:
            logger.error(f"Attempt {attempt} failed: {e}")

            if attempt < max_retries:
                logger.info(f"Retrying... ({attempt + 1}/{max_retries})")
                continue
            else:
                error_msg = f"All {max_retries} attempts failed. Last error: {e}"
                logger.error(error_msg)
                raise CrewExecutionError(error_msg) from e


def main():
    """Main entry point with comprehensive error handling."""
    exit_code = 0

    try:
        # Print banner
        print("=" * 60)
        print(f"  {{ project.name }}")
        print(f"  {{ project.description }}")
        print("=" * 60)
        print()

        # 1. Verify environment
        logger.info("Step 1: Verifying environment...")
        verify_environment()

        # 2. Import components
        logger.info("Step 2: Importing crew components...")
        Crew, Process, agents, tasks = import_crew_components()

        # 3. Create crew
        logger.info("Step 3: Creating crew...")
        crew = create_crew(Crew, Process, agents, tasks)

        # 4. Get inputs
        logger.info("Step 4: Collecting inputs...")
        inputs = get_inputs()

        # 5. Execute crew
        print()
        print("Starting crew execution...")
        print("-" * 40)

        result = execute_crew(crew, inputs, max_retries={{ retry_count | default(3) }})

        print("-" * 40)
        print("✅ Execution completed successfully!")
        print()
        print("=" * 60)
        print("RESULT:")
        print("=" * 60)
        print(result)
        print()

        # 6. Save result
        output_file = save_result(result, success=True)
        if output_file:
            print(f"📄 Result saved to: {output_file}")

        return result

    except CrewExecutionError as e:
        logger.error(f"Crew execution error: {e}")
        print(f"\n❌ Error: {e}")
        exit_code = 1

        # Save error details
        save_result(str(e), success=False)

    except KeyboardInterrupt:
        logger.info("Interrupted by user")
        print("\n⚠️  Execution cancelled by user")
        exit_code = 130

    except Exception as e:
        logger.error(f"Unexpected error: {e}")
        logger.error(traceback.format_exc())
        print(f"\n❌ Unexpected error: {e}")
        print("\nFor details, check crew_execution.log")
        exit_code = 1

        # Save error details
        error_details = f"{e}\n\n{traceback.format_exc()}"
        save_result(error_details, success=False)

    finally:
        if exit_code != 0:
            sys.exit(exit_code)


if __name__ == "__main__":
    main()
