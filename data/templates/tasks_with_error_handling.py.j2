class TaskConfigError(Exception):
    """Exception raised for task configuration errors."""
    pass


def validate_output_path(output_file: Optional[str]) -> Optional[str]:
    """
    Validate and create output directory if needed.

    Args:
        output_file: Output file path

    Returns:
        str: Validated output file path

    Raises:
        TaskConfigError: If path validation fails
    """
    if not output_file:
        return None

    try:
        output_path = Path(output_file)
        output_dir = output_path.parent

        # Create directory if it doesn't exist
        if output_dir != Path('.'):
            output_dir.mkdir(parents=True, exist_ok=True)
            logger.debug(f"Created output directory: {output_dir}")

        return str(output_path)

    except Exception as e:
        logger.error(f"Failed to validate output path {output_file}: {e}")
        raise TaskConfigError(f"Invalid output path: {e}") from e


def create_task_safe(
    description: str,
    expected_output: str,
    agent,
    context: Optional[List] = None,
    async_execution: bool = False,
    output_file: Optional[str] = None,
    human_input: bool = False,
    task_id: Optional[str] = None,
) -> Task:
    """
    Create a task with comprehensive error handling.

    Args:
        description: Task description
        expected_output: Expected output description
        agent: Agent to execute the task
        context: Context tasks
        async_execution: Enable async execution
        output_file: Output file path
        human_input: Enable human input
        task_id: Task identifier for logging

    Returns:
        Task: Configured task

    Raises:
        TaskConfigError: If task creation fails
    """
    try:
        # Validate agent
        if agent is None:
            raise TaskConfigError(f"Agent for task '{task_id}' is None")

        # Validate context
        if context:
            invalid_context = [c for c in context if c is None]
            if invalid_context:
                logger.warning(
                    f"Task '{task_id}' has {len(invalid_context)} invalid context tasks"
                )
                context = [c for c in context if c is not None]

        # Validate output file
        validated_output = validate_output_path(output_file)

        # Create task
        task = Task(
            description=description,
            expected_output=expected_output,
            agent=agent,
            context=context or [],
            async_execution=async_execution,
            output_file=validated_output,
            human_input=human_input,
        )

        logger.info(f"✅ Created task: {task_id or 'unnamed'}")
        return task

    except Exception as e:
        logger.error(f"❌ Failed to create task '{task_id}': {e}")
        raise TaskConfigError(f"Task creation failed for '{task_id}': {e}") from e


