# CrewAI Specification
# Generated by CAAS - CrewAI Agent Auto-generation System
# Project: {{ project.name }}
# Domain: {{ project.domain }}
# Generated at: {{ generated_at }}
#
# This specification follows the Spec-Driven Development (SDD) methodology.
# Modify with care and validate before code generation.

version: "{{ version | default('1.0') }}"

project:
  name: "{{ project.name }}"
  description: "{{ project.description }}"
  domain: "{{ project.domain }}"

agents:
{% for agent in agents %}
  - id: {{ agent.id }}
    role: "{{ agent.role }}"
    goal: |
      {{ agent.goal | indent(6) }}
    backstory: |
      {{ agent.backstory | indent(6) }}
    tools:
{% for tool in agent.tools %}
      - {{ tool }}
{% endfor %}
    llm:
      model: "{{ agent.llm.model | default('gpt-4-turbo-preview') }}"
      temperature: {{ agent.llm.temperature | default(0.7) }}
    verbose: {{ agent.verbose | default(true) | lower }}
    memory: {{ agent.memory | default(true) | lower }}
    allow_delegation: {{ agent.allow_delegation | default(false) | lower }}
    max_iter: {{ agent.max_iter | default(15) }}
{% if agent.max_rpm %}
    max_rpm: {{ agent.max_rpm }}
{% endif %}

{% endfor %}

tasks:
{% for task in tasks %}
  - id: {{ task.id }}
    description: |
      {{ task.description | indent(6) }}
    expected_output: |
      {{ task.expected_output | indent(6) }}
    agent: {{ task.agent }}
{% if task.context %}
    context:
{% for ctx in task.context %}
      - {{ ctx }}
{% endfor %}
{% endif %}
    async_execution: {{ task.async_execution | default(false) | lower }}
{% if task.output_file %}
    output_file: "{{ task.output_file }}"
{% endif %}
    human_input: {{ task.human_input | default(false) | lower }}

{% endfor %}

crew:
  process: {{ crew.process | default('sequential') }}
  verbose: {{ crew.verbose | default(true) | lower }}
  memory: {{ crew.memory | default(true) | lower }}
{% if crew.max_rpm %}
  max_rpm: {{ crew.max_rpm }}
{% endif %}
  share_crew: {{ crew.share_crew | default(false) | lower }}
