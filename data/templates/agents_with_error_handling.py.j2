def create_llm(
    model: str = "gpt-4-turbo-preview",
    temperature: float = 0.7,
    max_retries: int = 3,
    timeout: int = 60
) -> ChatOpenAI:
    """
    Create an LLM instance with error handling.

    Args:
        model: Model name
        temperature: Temperature parameter
        max_retries: Maximum number of retries
        timeout: Request timeout in seconds

    Returns:
        ChatOpenAI: Configured LLM instance

    Raises:
        AgentConfigError: If LLM creation fails
    """
    try:
        return ChatOpenAI(
            model=model,
            temperature=temperature,
            max_retries=max_retries,
            request_timeout=timeout,
        )
    except Exception as e:
        logger.error(f"Failed to create LLM with model {model}: {e}")
        raise AgentConfigError(f"LLM creation failed: {e}") from e


def create_tools(tool_names: List[str]) -> List:
    """
    Create tool instances with smart initialization and error handling.

    This function checks environment variables and initializes tools with
    required parameters. Optional tools are skipped with a warning if their
    requirements are not met.

    Args:
        tool_names: List of tool names

    Returns:
        list: Tool instances

    Raises:
        AgentConfigError: If required tool creation fails
    """
    tools = []

    for tool_name in tool_names:
        try:
            # Get tool class from mapping dictionary
            tool_class = TOOL_MAP.get(tool_name)

            if tool_class is None:
                logger.warning(f"Tool '{tool_name}' not found in TOOL_MAP, skipping")
                continue

            # Check if tool has special initialization requirements
            requirements = TOOL_REQUIREMENTS.get(tool_name, {})
            env_var = requirements.get("env_var")
            param_name = requirements.get("param_name")
            is_optional = requirements.get("optional", False)

            # Initialize tool based on requirements
            if env_var:
                # Tool requires environment variable
                env_value = os.getenv(env_var)

                if not env_value:
                    # Environment variable not set
                    if is_optional:
                        logger.warning(
                            f"⚠️  Skipping optional tool '{tool_name}': "
                            f"Environment variable '{env_var}' not set. "
                            f"This tool will not be available but the agent can still function."
                        )
                        continue
                    else:
                        error_msg = (
                            f"Required environment variable '{env_var}' not set for tool '{tool_name}'. "
                            f"Please set it in your .env file or environment."
                        )
                        logger.error(f"❌ {error_msg}")
                        raise EnvironmentError(error_msg)

                # Initialize with parameter if needed
                if param_name:
                    tool_instance = tool_class(**{param_name: env_value})
                    logger.info(f"✅ Created tool '{tool_name}' with {param_name} from {env_var}")
                else:
                    # Tool reads env var directly (e.g., SerperDevTool)
                    tool_instance = tool_class()
                    logger.info(f"✅ Created tool '{tool_name}' (uses {env_var} directly)")
            else:
                # Tool has no special requirements
                tool_instance = tool_class()
                logger.debug(f"✅ Created tool '{tool_name}'")

            tools.append(tool_instance)

        except EnvironmentError:
            # Re-raise environment errors for required tools
            raise

        except Exception as e:
            logger.error(f"❌ Failed to create tool '{tool_name}': {e}")

            # Check if this was an optional tool
            requirements = TOOL_REQUIREMENTS.get(tool_name, {})
            if requirements.get("optional", False):
                logger.warning(f"Continuing without optional tool '{tool_name}'")
                continue
            else:
                # For non-optional tools, continue but warn
                logger.warning(f"Continuing without tool '{tool_name}' due to error")
                continue

    if not tools and tool_names:
        logger.warning(
            "⚠️  No tools were successfully created. "
            "Agent will run without tools, which may limit functionality."
        )

    return tools


def create_agent_safe(
    role: str,
    goal: str,
    backstory: str,
    tools: Optional[List[str]] = None,
    llm_config: Optional[dict] = None,
    verbose: bool = True,
    memory: bool = True,
    allow_delegation: bool = False,
    max_iter: int = 15,
) -> Agent:
    """
    Create an agent with comprehensive error handling.

    Args:
        role: Agent role
        goal: Agent goal
        backstory: Agent backstory
        tools: List of tool names
        llm_config: LLM configuration dict
        verbose: Verbose output
        memory: Enable memory
        allow_delegation: Allow delegation
        max_iter: Maximum iterations

    Returns:
        Agent: Configured agent

    Raises:
        AgentConfigError: If agent creation fails
    """
    try:
        # Create LLM
        llm_config = llm_config or {}
        llm = create_llm(**llm_config)

        # Create tools
        agent_tools = create_tools(tools or [])

        # Create agent
        agent = Agent(
            role=role,
            goal=goal,
            backstory=backstory,
            tools=agent_tools,
            llm=llm,
            verbose=verbose,
            memory=memory,
            allow_delegation=allow_delegation,
            max_iter=max_iter,
        )

        logger.info(f"Created agent: {role}")
        return agent

    except Exception as e:
        logger.error(f"Failed to create agent {role}: {e}")
        raise AgentConfigError(f"Agent creation failed for {role}: {e}") from e


