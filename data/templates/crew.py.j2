def create_crew(
    verbose: bool = {{ verbose | default(true) | lower }},
    memory: bool = {{ memory | default(true) | lower }},
    process: str = "{{ process | default('sequential') }}",
    max_rpm: Optional[int] = {{ max_rpm | default('None') }},
) -> Crew:
    """
    CrewAI Crew 인스턴스를 생성합니다.

    Args:
        verbose: 상세 로그 출력 여부
        memory: 메모리 사용 여부
        process: 실행 프로세스 (sequential/hierarchical)
        max_rpm: 분당 최대 요청 수

    Returns:
        Crew: CrewAI Crew 인스턴스
    """
    # 에이전트 생성
    agents = create_agents()

    # 태스크 생성 (에이전트 참조 필요)
    tasks = create_tasks(agents)

    # 프로세스 유형 결정
    process_type = Process.hierarchical if process == "hierarchical" else Process.sequential

    # Crew 구성
    crew_config = {
        "agents": list(agents.values()),
        "tasks": tasks,
        "verbose": verbose,
        "memory": memory,
        "process": process_type,
    }

    {% if manager_llm %}
    # 계층적 프로세스를 위한 매니저 LLM
    if process == "hierarchical":
        from langchain_openai import ChatOpenAI
        crew_config["manager_llm"] = ChatOpenAI(
            model="{{ manager_llm | default('gpt-4') }}",
            temperature=0.7
        )
    {% endif %}

    if max_rpm:
        crew_config["max_rpm"] = max_rpm

    crew = Crew(**crew_config)

    return crew


def run_crew(
    inputs: dict = None,
    verbose: bool = True,
) -> Any:
    """
    Crew를 실행합니다.

    Args:
        inputs: 입력 데이터
        verbose: 상세 로그 출력 여부

    Returns:
        Any: Crew 실행 결과
    """
    crew = create_crew(verbose=verbose)

    if inputs:
        result = crew.kickoff(inputs=inputs)
    else:
        result = crew.kickoff()

    return result


