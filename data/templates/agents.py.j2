from crewai import Agent
from langchain_openai import ChatOpenAI
{% if tools %}
from crewai_tools import {{ tools | join(', ') }}
{% endif %}


{% for agent in agents %}
{{ agent.id }} = Agent(
    role="{{ agent.role }}",
    goal="""{{ agent.goal }}""",
    backstory="""{{ agent.backstory }}""",
    tools=[
        {% for tool in agent.tools %}
        {{ tool }}(),
        {% endfor %}
    ],
    llm=ChatOpenAI(
        model="{{ agent.llm.model | default('gpt-4-turbo-preview') }}",
        temperature={{ agent.llm.temperature | default(0.7) }},
    ),
    verbose={{ agent.verbose | default(true) }},
    memory={{ agent.memory | default(true) }},
    allow_delegation={{ agent.allow_delegation | default(false) }},
    max_iter={{ agent.max_iter | default(15) }},
)

{% endfor %}

# Agent list for easy access
AGENTS = [
    {% for agent in agents %}
    {{ agent.id }},
    {% endfor %}
]


def create_agents() -> dict:
    """
    Create and return all agents as a dictionary.

    Returns:
        dict: Dictionary mapping agent IDs to agent instances
    """
    return {
        {% for agent in agents %}
        "{{ agent.id }}": {{ agent.id }},
        {% endfor %}
    }
